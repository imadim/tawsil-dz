# انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# cp .env.example .env

# ---- Flask ----
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production
FLASK_DEBUG=0

# ---- Database ----
# اتركه فارغاً لاستخدام SQLite محلياً
# في الإنتاج ضع رابط PostgreSQL، مثال:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ---- Google Maps ----
GOOGLE_MAPS_API_KEY=

# ---- Stripe ----
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# ---- SMS ----
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=

# ---- Payment gateways (Algeria) ----
CIB_MERCHANT_ID=
CIB_API_KEY=
EDAHABIA_MERCHANT_ID=
EDAHABIA_API_KEY=

# ---- Firebase ----
FIREBASE_CREDENTIALS=
