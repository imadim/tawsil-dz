# انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# cp .env.example .env

# ---- Flask ----
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production
FLASK_DEBUG=0

# ---- Database ----
# اتركه فارغاً لاستخدام SQLite محلياً
# في الإنتاج ضع رابط PostgreSQL، مثال:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ---- تسجيل الدخول بحساب جوجل ----
# أنشئ Client ID من: console.cloud.google.com → APIs & Services → Credentials
# نوعه: OAuth client ID → Web application
# Authorized redirect URI:  https://<موقعك>/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- الدفع الإلكتروني ----
# 1 = وضع تجريبي (محاكاة موسومة) · 0 = بوابة حقيقية بمفاتيح تاجر
PAYMENTS_SANDBOX=1
SATIM_MERCHANT_ID=
SATIM_API_KEY=
BARIDIMOB_MERCHANT=

# ---- الخرائط ----
# لا حاجة لأي مفتاح: المشروع يستخدم Leaflet مع بلاطات OpenStreetMap
# والتوجيه عبر خادم OSRM العمومي — كلاهما مجاني وبدون تسجيل.

# ---- Stripe ----
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# ---- SMS ----
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=

# ---- Payment gateways (Algeria) ----
CIB_MERCHANT_ID=
CIB_API_KEY=
EDAHABIA_MERCHANT_ID=
EDAHABIA_API_KEY=

# ---- Firebase ----
FIREBASE_CREDENTIALS=
